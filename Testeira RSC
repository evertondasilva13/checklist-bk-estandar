 modalTipoTitle:'Tipo de Evaluación', modalTipoDesc:'Seleccione antes de iniciar la inspección',
 tipoProto:'Prototipo', tipoMass:'Entrega Masiva',
 fornecedorLabel:'Nombre del Proveedor', fornecedorPh:'Ej: Empresa XYZ Ltda',
 iniciarAval:'Iniciar Evaluación',
 tipoProtoDesc:'Nuevo equipamiento de un nuevo proveedor',
 tipoMassDesc:'Entrega de lote de unidades con un proveedor ya homologado'
 },
 pt: {
 title:"Checklist Testeira RSC", subtitle:"Avalia\u00e7\u00e3o de Equipamento",
 infoTitle:'Informações da Avaliação',
 evaluador:'Avaliador', evaluadorPh:'Seu nome completo',
 fecha:'Data', sitio:'Site / Armazém', sitioPh:'Ex: CD São Paulo', pais:'País',
 itensEval:'Itens avaliados', items:'itens', items2:'itens',
 secEq:"Testeira RSC", secEs:'Estrutura',
 resultado:'Resultado da Avaliação',
 lblEq:"Testeira RSC (60%)", lblEs:'Estrutura (40%)',
 evalFinal:'Avaliação Final',
 scaleNote:'0%–40% Reprovado &nbsp;·&nbsp; 41%–80% Realizar ajustes &nbsp;·&nbsp; 81%–100% Aprovado',
 finalizar:'Finalizar avaliação',
 malo:'Ruim', interm:'Méd.', excel:'Exce.',
 herramienta:'Ferramenta', comentarios:'Comentários',
 obsPlaceholder:'Observações...', fotos:'Fotos', addMedia:'Adicionar fotos',
 refLabel:'Referência do desenho',
 verdicts:{ rep:'Reprovado', aj:'Ajustes', ap:'Aprovado' },
 modalTipoTitle:'Tipo de Avaliação', modalTipoDesc:'Selecione antes de iniciar a inspeção',
 tipoProto:'Protótipo', tipoMass:'Entrega Massiva',
 fornecedorLabel:'Nome do Fornecedor', fornecedorPh:'Ex: Empresa XYZ Ltda',
 iniciarAval:'Iniciar Avaliação',
 tipoProtoDesc:'Novo equipamento de um novo fornecedor',
 tipoMassDesc:'Entrega de lote de unidades com um fornecedor já homologado'
 }
};

const ITEMS = {
 eq: [{n:1,t:"Longitud Total",s:"1120mm (±2mm) — verificar con cinta métrica",c:"Malo: Longitud fuera de tolerancia >5mm.\nIntermedio: Variación 2–5mm.\nExcelente: 1120mm dentro de ±2mm de tolerancia.",h:"Cinta métrica / Trena"},
 {n:2,t:"Ganchos Frontales",s:"3 unidades (344mm c/u) presentes y posicionadas correctamente",c:"Malo: Ganchos ausentes, incorrectos o con posicionamiento errado.\nIntermedio: Ganchos presentes pero con alineación irregular en 1 gancho.\nExcelente: 3 ganchos frontales (344mm) presentes y correctamente posicionados.",h:"Evaluación visual · Cinta métrica"},
 {n:3,t:"Ganchos Ajustables",s:"2 unidades (120mm) presentes y en posición correcta",c:"Malo: Ganchos ausentes o incorrectos.\nIntermedio: Ganchos presentes pero con posicionamiento irregular.\nExcelente: 2 ganchos ajustables (120mm) presentes y en posición correcta.",h:"Evaluación visual"},
 {n:4,t:"Chapas + Tornillos M6",s:"2× + 2× instalados y apretados",c:"Malo: Chapas o tornillos ausentes o sueltos.\nIntermedio: Presentes pero con fijación irregular.\nExcelente: 2 chapas + 2 tornillos instalados y bien apretados.",h:"Evaluación visual · Llave"}],
 es: [{n:1,t:"Pintura Epóxi",s:"Gris oscuro, uniforme — sin fallas, burbujas ni descascaramiento",c:"Malo: Descascaramiento severo, burbujas o zonas sin cobertura.\nIntermedio: Pequeñas irregularidades sin comprometer la protección.\nExcelente: Pintura epóxi gris oscuro uniforme sin defectos.",h:"Evaluación visual"},
 {n:2,t:"Aristas y Acabado",s:"Desbarbadas y sin puntas agudas en toda la pieza",c:"Malo: Aristas cortantes o puntas agudas que representan riesgo.\nIntermedio: Algunas aristas con rebaba menor.\nExcelente: Todas las aristas desbarbadas y suaves.",h:"Evaluación visual / táctil"},
 {n:3,t:"Alineación y Fijación de Ganchos",s:"Ganchos alineados, fijación firme — sin holgura lateral",c:"Malo: Ganchos desalineados o con holgura significativa.\nIntermedio: Alineación con variación menor (<2mm).\nExcelente: Ganchos perfectamente alineados y fijación sin holgura.",h:"Evaluación visual · Prueba manual"}]
};
const ITEMS_PT = {
 eq: [{n:1,t:"Comprimento Total",s:"1120mm (±2mm) — verificar com trena",c:"Ruim: Comprimento fora de tolerância >5mm.\nIntermediário: Variação 2–5mm.\nExcelente: 1120mm dentro de ±2mm de tolerância.",h:"Fita métrica / Trena"},
 {n:2,t:"Ganchos Frontais",s:"3 unidades (344mm cada) presentes e posicionados corretamente",c:"Ruim: Ganchos ausentes, incorretos ou com posicionamento errado.\nIntermediário: Ganchos presentes mas com alinhamento irregular em 1 gancho.\nExcelente: 3 ganchos frontais (344mm) presentes e corretamente posicionados.",h:"Avaliação visual · Fita métrica"},
 {n:3,t:"Ganchos Ajustáveis",s:"2 unidades (120mm) presentes e na posição correta",c:"Ruim: Ganchos ausentes ou incorretos.\nIntermediário: Ganchos presentes mas com posicionamento irregular.\nExcelente: 2 ganchos ajustáveis (120mm) presentes e na posição correta.",h:"Avaliação visual"},
 {n:4,t:"Chapas + Parafusos M6",s:"2× + 2× instalados e apertados",c:"Ruim: Chapas ou parafusos ausentes ou soltos.\nIntermediário: Presentes mas com fixação irregular.\nExcelente: 2 chapas + 2 parafusos instalados e bem apertados.",h:"Avaliação visual · Chave"}],
 es: [{n:1,t:"Pintura Epóxi",s:"Cinza escuro, uniforme — sem falhas, bolhas ou descascamento",c:"Ruim: Descascamento severo, bolhas ou zonas sem cobertura.\nIntermediário: Pequenas irregularidades sem comprometer a proteção.\nExcelente: Pintura epóxi cinza escuro uniforme sem defeitos.",h:"Avaliação visual"},
 {n:2,t:"Arestas e Acabamento",s:"Rebarbadas e sem pontas agudas em toda a peça",c:"Ruim: Arestas cortantes ou pontas agudas que representam risco.\nIntermediário: Algumas arestas com rebarba menor.\nExcelente: Todas as arestas rebarbadas e suaves.",h:"Avaliação visual / tátil"},
 {n:3,t:"Alinhamento e Fixação dos Ganchos",s:"Ganchos alinhados, fixação firme — sem folga lateral",c:"Ruim: Ganchos desalinhados ou com folga significativa.\nIntermediário: Alinhamento com variação menor (<2mm).\nExcelente: Ganchos perfeitamente alinhados e fixação sem folga.",h:"Avaliação visual · Teste manual"}]
};

const REF_IMGS = {
 "eq_0": ["data:image/jpeg;base64,"],
 "eq_1": ["data:image/jpeg;base64,"],
 "eq_2": ["data:image/jpeg;base64,"],
 "eq_3": ["data:image/jpeg;base64,"],
 "es_0": ["data:image/jpeg;base64,"],
 "es_2": ["data:image/jpeg;base64,"]
};

const R = { eq: new Array(4).fill(null), es: new Array(3).fill(null) };
const SM = { malo:.25, intermedio:.65, excelente:1 };
const N_TOT = 7;

function buildItem(item, sec, idx) {
 const key = sec + '_' + idx;
 const refImgs = REF_IMGS[key] || [];
 const refHtml = refImgs.length ? `
 <div class="ref-photos">
 <div class="ref-label">${T[LANG].refLabel}</div>
 <div class="ref-row">${refImgs.map((src,i) => `<img class="ref-img" src="${src}" alt="ref ${i+1}" onclick="openLightbox('${src}')">`).join('')}</div>
 </div>` : '';
 return `
 <div class="item">
 <div class="item-hdr" onclick="toggleItem(this)">
 <div class="item-num">${item.n}</div>
 <div class="item-main">
 <div class="item-title">${item.t}</div>
 <div class="item-sub">${item.s}</div>
 </div>
 <div class="rating-inline" onclick="event.stopPropagation()">
 <button class="rb malo" onclick="rate('${sec}',${idx},'malo',this)">${S1}<span class="rb-lbl">${T[LANG].malo}</span></button>
 <button class="rb intermedio" onclick="rate('${sec}',${idx},'intermedio',this)">${S2}<span class="rb-lbl">${T[LANG].interm}</span></button>
 <button class="rb excelente" onclick="rate('${sec}',${idx},'excelente',this)">${S3}<span class="rb-lbl">${T[LANG].excel}</span></button>
 </div>
 <div class="chev"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></div>
 </div>
 <div class="item-detail">
 ${refHtml}
 <div class="crit">${item.c}</div>
 <div class="tool"><div class="tool-lbl">${T[LANG].herramienta}</div>${item.h}</div>
 <div class="cmnt"><label>${T[LANG].comentarios}</label><textarea placeholder="${T[LANG].obsPlaceholder}"></textarea></div>
 <div class="photos"><label>${T[LANG].fotos}</label>
 <div class="pdrop" onclick="this.querySelector('input').click()">
 <input type="file" accept="image/*" multiple onchange="previewF(this)">
 <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
 <div class="pdrop-txt">${T[LANG].addMedia}</div>
 </div>
 <div class="ppreview"></div>
 </div>
 </div>
 </div>`;
}

function renderAllItems() {
 Object.entries(ITEMS).forEach(([sec, items]) => {
 const bd = document.getElementById('bd-'+sec);
 if (bd) bd.innerHTML = items.map((it,i) => buildItem(it,sec,i)).join('');
 });
}

function switchLang(lang) {
 LANG = lang;
 document.getElementById('btn-pt').classList.toggle('act', lang==='pt');
 document.getElementById('btn-es').classList.toggle('act', lang==='es');
 const t = T[lang];
 document.querySelectorAll('[data-i18n]').forEach(el => {
 const k = el.getAttribute('data-i18n');
 if (t[k] !== undefined) el.innerHTML = t[k];
 });
 document.querySelectorAll('[data-i18n-ph]').forEach(el => {
 const k = el.getAttribute('data-i18n-ph');
 if (t[k] !== undefined) el.placeholder = t[k];
 });
 const src = lang === 'pt' ? ITEMS_PT : ITEMS;
 Object.entries(src).forEach(([sec, items]) => {
 const bd = document.getElementById('bd-'+sec);
 if (!bd) return;
 bd.innerHTML = items.map((it,i) => buildItem(it,sec,i)).join('');
 R[sec].forEach((val,i) => {
 if (val !== null) {
 const btns = bd.querySelectorAll('.item');
 if (btns[i]) {
 const btn = btns[i].querySelector('.rb.'+val);
 if (btn) btn.classList.add('sel');
 }
 }
 });
 });
 document.title = t.title + ' — Mercado Libre';
}

if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', () => { renderAllItems(); document.getElementById('fecha').value = new Date().toISOString().slice(0,10); });
} else {
 renderAllItems();
 document.getElementById('fecha').value = new Date().toISOString().slice(0,10);
}

function toggleSec(id, hdr) {
 const bd = document.getElementById('bd-'+id);
 const chev = hdr.querySelector('.sec-chev');
 const open = bd.style.display !== 'none';
 bd.style.display = open ? 'none' : 'block';
 chev.classList.toggle('open', !open);
}
function toggleItem(hdr) {
 const det = hdr.nextElementSibling;
 const chev = hdr.querySelector('.chev');
 det.classList.toggle('open');
 chev.classList.toggle('open');
}
function rate(sec, idx, val, btn) {
 if (btn.classList.contains('sel')) {
 R[sec][idx] = null;
 btn.classList.remove('sel');
 calcAll(); return;
 }
 R[sec][idx] = val;
 btn.closest('.rating-inline').querySelectorAll('.rb').forEach(b => b.classList.remove('sel'));
 btn.classList.add('sel');
 calcAll();
 const currentHdr = btn.closest('.item-hdr');
 if (currentHdr) {
 const det = currentHdr.nextElementSibling;
 if (det && det.classList.contains('open')) { det.classList.remove('open'); currentHdr.querySelector('.chev')?.classList.remove('open'); }
 const next = currentHdr.closest('.item').nextElementSibling;
 if (next && next.classList.contains('item')) {
 const nd = next.querySelector('.item-detail');
 if (nd && !nd.classList.contains('open')) {
 nd.classList.add('open'); next.querySelector('.chev')?.classList.add('open');
 setTimeout(() => next.querySelector('.item-hdr').scrollIntoView({behavior:'smooth',block:'nearest'}), 80);
 }
 }
 }
}

function avg(sec) {
 const vals = R[sec].filter(v => v !== null);
 if (!vals.length) return null;
 return vals.reduce((a,v) => a + SM[v], 0) / vals.length;
}
function setBar(id, score) {
 const bar = document.getElementById('bar-'+id);
 const val = document.getElementById('val-'+id);
 const bdg = document.getElementById('sc-'+id);
 if (score === null) { bar.style.width='0%'; val.textContent='—'; val.style.color='#999'; if(bdg) bdg.textContent='—'; return; }
 const p = Math.round(score * 100);
 const c = p<=40 ? 'var(--bad)' : p<=80 ? 'var(--mid)' : 'var(--ok)';
 bar.style.width=p+'%'; bar.style.background=c; val.textContent=p+'%'; val.style.color=c;
 if(bdg) bdg.textContent=p+'%';
}
function calcAll() {
 const eq = avg('eq'), es = avg('es');
 setBar('eq', eq); setBar('es', es);
 const done = ['eq','es'].reduce((a,s) => a + R[s].filter(v=>v!==null).length, 0);
 document.getElementById('pFill').style.width = (done/N_TOT*100)+'%';
 document.getElementById('pCount').textContent = done+' / '+N_TOT;
 let fin = null;
 if (eq!==null && es!==null) fin = eq*.6 + es*.4;
 else if (eq!==null) fin = eq*.6;
 else if (es!==null) fin = es*.4;
 if (fin !== null) {
 const p = Math.round(fin*100);
 document.getElementById('val-tot').textContent = p+'%';
 document.getElementById('hdrVal').textContent = p+'%';
 const vd = T[LANG].verdicts; const [txt,cls] = p<=40 ? [vd.rep,'v-rep'] : p<=80 ? [vd.aj,'v-aj'] : [vd.ap,'v-ap'];
 const v = document.getElementById('vdict'); v.textContent=txt; v.className='verdict '+cls;
 } else {
 document.getElementById('val-tot').textContent='—';
 document.getElementById('hdrVal').textContent='—';
 document.getElementById('vdict').textContent='';
 }
}

function previewF(input) {
 const prev = input.closest('.photos').querySelector('.ppreview');
 Array.from(input.files).forEach(f => {
 if (!f.type.startsWith('image/')) return;
 const r = new FileReader();
 r.onload = e => {
 const t = document.createElement('div'); t.className = 'pthumb';
 t.innerHTML = '<img src="'+e.target.result+'"><button class="prm" onclick="this.parentElement.remove()">×</button>';
 prev.appendChild(t);
 };
 r.readAsDataURL(f);
 });
}

function showToast(msg, items) {
 document.getElementById('valToastMsg').textContent = msg;
 document.getElementById('valToastList').innerHTML = items.map(i => '• '+i).join('<br>');
 const t = document.getElementById('valToast'); t.classList.remove('show'); void t.offsetWidth; t.classList.add('show');
 setTimeout(() => t.classList.remove('show'), 6000);
}

async function finalize() {
 const done = ['eq','es'].reduce((a,s) => a + R[s].filter(v=>v!==null).length, 0);
 if (done < N_TOT) {
 showToast(LANG==='pt' ? 'Avaliação incompleta' : 'Evaluación incompleta',
 [LANG==='pt' ? 'Faltam '+(N_TOT-done)+' item(ns) por avaliar.' : 'Faltan '+(N_TOT-done)+' ítem(s) por evaluar.']);
 return;
 }
 const evaluadorVal = document.getElementById('evaluador').value.trim();
 const sitioVal = document.getElementById('sitio').value.trim();
 const paisVal = document.getElementById('pais').value.trim();
 if (!evaluadorVal || !sitioVal || !paisVal) {
 const missing = [];
 if (!evaluadorVal) missing.push(LANG==='pt' ? 'Nome do avaliador é obrigatório.' : 'El nombre del evaluador es obligatorio.');
 if (!sitioVal) missing.push(LANG==='pt' ? 'Site é obrigatório.' : 'El sitio es obligatorio.');
 if (!paisVal) missing.push(LANG==='pt' ? 'País é obrigatório.' : 'El país es obligatorio.');
 ['evaluador','sitio','pais'].forEach(id => document.getElementById(id).style.borderColor = document.getElementById(id).value.trim() ? '' : 'var(--bad)');
 showToast(LANG==='pt' ? 'Campos obrigatórios' : 'Campos obligatorios', missing);
 window.scrollTo({top:0,behavior:'smooth'}); return;
 }
 ['evaluador','sitio','pais'].forEach(id => document.getElementById(id).style.borderColor = '');

 const comentarios = {};
 document.querySelectorAll('.item').forEach((el, i) => {
 const ta = el.querySelector('textarea');
 if (ta && ta.value.trim()) comentarios[i] = ta.value.trim();
 });

 const eq = avg('eq'), es = avg('es');
 const fin = eq!==null && es!==null ? eq*.6+es*.4 : eq!==null ? eq*.6 : es*.4;
 const p = Math.round(fin*100);
 const vd = T[LANG].verdicts;
 const veredicto = p<=40 ? vd.rep : p<=80 ? vd.aj : vd.ap;

 const payload = {
 evaluador: evaluadorVal,
 fecha: document.getElementById('fecha').value || null,
 sitio: sitioVal,
 pais: paisVal,
 idioma: LANG,
 score_eq: eq !== null ? Math.round(eq*100) : null,
 score_es: es !== null ? Math.round(es*100) : null,
 score_final: p, veredicto,
 ratings: { eq: R.eq, es: R.es },
 comentarios, fotos: [],
 equipo_tipo: 'Testeira RSC',
 tipo_avaliacao: tipoAvaliacao,
 fornecedor: fornecedorNome || null
 };

 const btn = document.querySelector('[data-i18n="finalizar"]');
 const orig = btn.textContent;
 btn.textContent = 'Enviando...'; btn.disabled = true;

 try {
 const uploadQueue = [];
 document.querySelectorAll('.item').forEach((el, globalIdx) => {
 el.querySelectorAll('.ppreview img').forEach((img, pi) => {
 uploadQueue.push({ globalIdx, pi, src: img.src });
 });
 });

 let evalId = null;
 const { data, error } = await _sb.from('evaluaciones').insert([payload]).select('id').single();
 if (error) throw error;
 evalId = data.id;

 if (uploadQueue.length > 0 && evalId) {
 await Promise.all(uploadQueue.map(async ({globalIdx, pi, src}) => {
 const b64 = src.split(',')[1];
 if (!b64) return;
 const bytes = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
 const path = `${evalId}/item${globalIdx}_${pi}.jpg`;
 const { data: udata, error: uerr } = await _sb.storage.from('avaliacoes-fotos').upload(path, bytes, {contentType:'image/jpeg'});
 if (!uerr && udata) {
 const { data: pub } = _sb.storage.from('avaliacoes-fotos').getPublicUrl(path);
 payload.fotos.push({ url: pub.publicUrl, item: globalIdx, num: pi });
 }
 }));
 }

 const params = new URLSearchParams({
 lang: LANG, score: p, veredicto,
 evaluador: evaluadorVal, sitio: sitioVal,
 tipo: tipoAvaliacao || '', fornecedor: fornecedorNome || ''
 });
 window.location.href = 'obrigado.html?' + params.toString();
 } catch(e) {
 console.error(e);
 showToast('Error', [e.message || 'No se pudo guardar la evaluación.']);
 btn.textContent = orig; btn.disabled = false;
 }
}
</script>
</body>
</html>
