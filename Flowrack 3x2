<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checklist Flowrack 3x2m — Mercado Libre</title>
<style>
  :root {
    --y: #FFE600; --yd: #E6CF00;
    --dk: #1A1A1A; --g: #666; --lt: #F5F5F5; --br: #E0E0E0;
    --bad: #E8303F; --mid: #FF7733; --ok: #00A650;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: var(--lt); color: var(--dk); }

  header { background: var(--y); padding: 0 20px; display: flex; align-items: center; justify-content: space-between; height: 58px; box-shadow: 0 2px 6px rgba(0,0,0,.15); position: sticky; top: 0; z-index: 100; }
  .logo { display: flex; align-items: center; gap: 10px; }
  .logo-icon { width: 34px; height: 34px; background: var(--dk); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--y); font-weight: 900; font-size: 13px; }
  .logo-text { font-size: 16px; font-weight: 800; color: var(--dk); }
  .logo-sub { font-size: 11px; color: #555; }

  .lang-toggle { display:flex; gap:4px; align-items:center; }
  .lang-toggle button { background:transparent; border:2px solid var(--dk); color:var(--dk); padding:3px 10px; border-radius:14px; font-size:11px; font-weight:800; cursor:pointer; transition:all .15s; }
  .lang-toggle button.act { background:var(--dk); color:var(--y); }
  .hdr-score { background: var(--dk); color: var(--y); padding: 6px 16px; border-radius: 18px; font-size: 13px; font-weight: 700; }

  main { max-width: 860px; margin: 0 auto; padding: 18px 12px 80px; }

  .card { background: white; border-radius: 10px; padding: 18px; margin-bottom: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.07); }
  .card-top { border-top: 4px solid var(--y); }
  .card h2 { font-size: 16px; font-weight: 700; margin-bottom: 13px; }

  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media(max-width:540px){.form-grid{grid-template-columns:1fr}}
  .field label { display: block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--g); margin-bottom: 4px; }
  .field input, .field select { width: 100%; border: 1.5px solid var(--br); border-radius: 7px; padding: 8px 11px; font-size: 13px; outline: none; transition: border-color .2s; background: white; }
  .field input:focus, .field select:focus { border-color: var(--dk); }

  .prog-wrap { display: flex; align-items: center; gap: 12px; }
  .prog-wrap span { font-size: 12px; font-weight: 600; min-width: 120px; }
  .prog-track { flex: 1; height: 7px; background: var(--br); border-radius: 4px; overflow: hidden; }
  .prog-fill { height: 100%; background: var(--dk); border-radius: 4px; transition: width .4s; width: 0%; }
  .prog-count { font-size: 12px; font-weight: 700; min-width: 44px; text-align: right; }

  .section { background: white; border-radius: 10px; margin-bottom: 14px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.07); }
  .sec-hdr { background: var(--dk); color: white; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; }
  .sec-hdr h3 { font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 7px; }
  .sec-badge { background: rgba(255,230,0,.18); color: var(--y); padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 700; }
  .sec-weight { font-size: 10px; opacity: .65; }
  .sec-score { background: var(--y); color: var(--dk); padding: 3px 11px; border-radius: 11px; font-size: 11px; font-weight: 700; min-width: 48px; text-align: center; }
  .sec-chev { transition: transform .2s; }
  .sec-chev.open { transform: rotate(180deg); }

  .item { border-bottom: 1px solid var(--br); }
  .item:last-child { border-bottom: none; }

  .item-hdr { padding: 11px 14px; display: flex; align-items: center; gap: 9px; cursor: pointer; transition: background .12s; }
  .item-hdr:hover { background: #f9f9f9; }
  .item-num { background: var(--y); color: var(--dk); width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 800; flex-shrink: 0; }
  .item-main { flex: 1; min-width: 0; }
  .item-title { font-size: 13px; font-weight: 600; }
  .item-sub { font-size: 11px; color: var(--g); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .rating-inline { display: flex; gap: 5px; flex-shrink: 0; align-items: center; }
  .rb {
    border: 1.5px solid var(--br); background: white;
    padding: 5px 7px; border-radius: 7px; cursor: pointer;
    transition: all .15s; display: flex; flex-direction: column; align-items: center; gap: 2px;
    min-width: 46px; color: #C0C0C0;
  }
  .rb:hover { border-color: #999; color: #777; }
  .rb-lbl { font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: .3px; color: inherit; line-height: 1; }
  .rb.malo.sel        { color: var(--bad);  border-color: var(--bad);  background: #fff0f1; }
  .rb.intermedio.sel  { color: var(--mid);  border-color: var(--mid);  background: #fff5ee; }
  .rb.excelente.sel   { color: var(--ok);   border-color: var(--ok);   background: #edfff5; }
  .rb.malo:not(.sel):hover        { color: var(--bad); border-color: #f9b; }
  .rb.intermedio:not(.sel):hover  { color: var(--mid); border-color: #fdb; }
  .rb.excelente:not(.sel):hover   { color: var(--ok);  border-color: #9db; }

  .chev { flex-shrink: 0; color: var(--g); transition: transform .2s; }
  .chev.open { transform: rotate(180deg); }

  .item-detail { display: none; padding: 0 14px 16px 46px; background: #fafafa; border-top: 1px dashed var(--br); }
  .item-detail.open { display: block; }

  .crit { background: #efefef; border-left: 3px solid var(--dk); border-radius: 0 6px 6px 0; padding: 10px 12px; margin: 10px 0; font-size: 12px; color: #222; line-height: 1.6; white-space: pre-line; }
  .tool { background: #FFFCE0; border-left: 3px solid var(--yd); border-radius: 0 6px 6px 0; padding: 8px 12px; margin: 7px 0; font-size: 12px; color: #4a3e00; line-height: 1.5; }
  .tool-lbl { font-weight: 700; font-size: 9px; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 2px; color: #7a6500; }
  .media-row { display: flex; gap: 7px; margin: 8px 0; flex-wrap: wrap; }
  .vchip { background: var(--dk); color: var(--y); padding: 4px 10px; border-radius: 14px; font-size: 10px; font-weight: 600; display: flex; align-items: center; gap: 4px; text-decoration: none; cursor: pointer; }
  a.vchip:hover { background: #333; }
  .ref-photos { margin: 10px 0 6px; }
  .ref-label { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--g); margin-bottom: 6px; }
  .ref-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .ref-img-wrap { display: inline-flex; flex-direction: column; align-items: center; }
  .ref-img-lbl { font-size: 10px; font-weight: 700; color: #1d4ed8; text-align: center; margin-bottom: 4px; letter-spacing: 0.04em; text-transform: uppercase; }
  .ref-img { width: 80px; height: 80px; object-fit: cover; border-radius: 6px; border: 2px solid var(--br); cursor: zoom-in; transition: border-color .15s; }
  .ref-img:hover { border-color: var(--dk); }
  .lb-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.88); z-index:999; align-items:center; justify-content:center; cursor:zoom-out; }
  .lb-overlay.open { display:flex; }
  .lb-img { max-width:90vw; max-height:90vh; border-radius:8px; box-shadow: 0 8px 32px rgba(0,0,0,.5); }

  .val-toast { display:none; position:fixed; bottom:24px; left:50%; transform:translateX(-50%); background:#1A1A1A; color:white; border-radius:12px; padding:14px 20px; max-width:420px; width:calc(100% - 32px); z-index:200; box-shadow:0 4px 20px rgba(0,0,0,.25); }
  .val-toast.show { display:block; animation: slideUp .25s ease; }
  @keyframes slideUp { from { opacity:0; transform:translateX(-50%) translateY(16px); } to { opacity:1; transform:translateX(-50%) translateY(0); } }
  .val-toast-hdr { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:700; color:var(--y); margin-bottom:6px; }
  .val-toast-list { font-size:12px; color:#ddd; line-height:1.7; }
  .val-toast-close { margin-left:auto; background:none; border:none; color:#aaa; cursor:pointer; font-size:18px; line-height:1; padding:0 2px; }
  .val-toast-close:hover { color:white; }
  .sugg { background: #F5F0FF; border-left: 3px solid #8B6FD4; border-radius: 0 6px 6px 0; padding: 8px 12px; margin: 7px 0; font-size: 11.5px; color: #3D2A7A; white-space: pre-line; line-height: 1.5; }
  .cmnt { margin-top: 9px; }
  .cmnt label { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--g); display: block; margin-bottom: 4px; }
  .cmnt textarea { width: 100%; border: 1.5px solid var(--br); border-radius: 6px; padding: 8px 10px; font-size: 12px; resize: vertical; min-height: 58px; outline: none; font-family: inherit; transition: border-color .2s; }
  .cmnt textarea:focus { border-color: var(--dk); }
  .photos { margin-top: 9px; }
  .photos label { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--g); display: block; margin-bottom: 5px; }
  .pdrop { border: 2px dashed var(--br); border-radius: 8px; padding: 12px; text-align: center; cursor: pointer; transition: all .2s; background: white; }
  .pdrop:hover { border-color: var(--dk); background: #f8f8f8; }
  .pdrop input { display: none; }
  .pdrop-txt { font-size: 11px; color: var(--g); margin-top: 4px; }
  .ppreview { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 7px; }
  .pthumb { position: relative; width: 64px; height: 64px; border-radius: 6px; overflow: hidden; border: 2px solid var(--br); }
  .pthumb img { width: 100%; height: 100%; object-fit: cover; }
  .prm { position: absolute; top: 2px; right: 2px; background: rgba(0,0,0,.55); color: white; border: none; border-radius: 50%; width: 15px; height: 15px; cursor: pointer; font-size: 8px; display: flex; align-items: center; justify-content: center; }

  .score-panel { background: white; border-radius: 10px; padding: 18px; margin-bottom: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.07); border-top: 4px solid var(--y); }
  .score-panel h3 { font-size: 15px; font-weight: 700; margin-bottom: 16px; }
  .srows { display: flex; flex-direction: column; gap: 10px; }
  .srow { display: flex; align-items: center; gap: 9px; }
  .srow-lbl { font-size: 12px; font-weight: 600; min-width: 158px; }
  .sbar-wrap { flex: 1; height: 9px; background: var(--br); border-radius: 5px; overflow: hidden; }
  .sbar { height: 100%; border-radius: 5px; transition: width .5s, background .3s; background: var(--dk); width: 0%; }
  .sval { min-width: 42px; text-align: right; font-size: 13px; font-weight: 700; }
  .sdiv { border: none; border-top: 1px solid var(--br); margin: 5px 0; }
  .stotal { display: flex; align-items: center; gap: 9px; background: var(--dk); border-radius: 8px; padding: 13px 15px; margin-top: 5px; }
  .stotal-lbl { font-size: 13px; font-weight: 700; color: white; flex: 1; }
  .stotal-val { font-size: 21px; font-weight: 900; color: var(--y); }
  .verdict { font-size: 11px; font-weight: 700; padding: 3px 11px; border-radius: 14px; margin-left: 5px; }
  .v-rep { background: var(--bad); color: white; }
  .v-ev  { background: var(--mid); color: white; }
  .v-aj  { background: #D07800; color: white; }
  .v-ap  { background: var(--ok);  color: white; }
  .scale-note { margin-top: 12px; font-size: 11px; color: var(--g); line-height: 1.7; }

  .actions { display: flex; gap: 9px; justify-content: flex-end; flex-wrap: wrap; margin-top: 18px; }
  .btn { padding: 10px 22px; border-radius: 7px; font-size: 13px; font-weight: 700; cursor: pointer; border: none; transition: all .15s; }
  .btn-outline { background: white; color: var(--dk); border: 2px solid var(--dk); }
  .btn-outline:hover { background: #f0f0f0; }
  .btn-y { background: var(--y); color: var(--dk); }
  .btn-y:hover { background: var(--yd); }
  .btn-dk { background: var(--dk); color: var(--y); }
  .btn-dk:hover { background: #333; }
  @media print { header{position:relative} .btn{display:none} .item-detail{display:block!important} .pdrop{display:none} }

/* ── Tipo Modal ── */
#modal-tipo { position:fixed; inset:0; background:rgba(0,0,0,.65); z-index:2000; display:flex; align-items:center; justify-content:center; }
.modal-box { background:var(--lt); border-radius:14px; padding:2rem 2rem 1.5rem; max-width:440px; width:92%; text-align:center; border:2px solid var(--br); }
.modal-box h2 { margin:0 0 .4rem; font-size:1.25rem; color:var(--dk); }
.modal-box p  { margin:0 0 1.4rem; font-size:.9rem; color:var(--g); }
.tipo-btns { display:flex; gap:.9rem; margin-bottom:1.4rem; }
.tipo-btn { flex:1; padding:1.1rem .5rem; border:2px solid var(--br); border-radius:10px; background:#fff; cursor:pointer; font-size:.95rem; font-weight:600; color:var(--dk); transition:all .18s; }
.tipo-btn:hover { border-color:#bbb; background:var(--lt); }
.tipo-btn.sel { border-color:var(--y); background:var(--y); color:var(--dk); }
.tipo-btn .tipo-icon { font-size:1.8rem; display:block; margin-bottom:.35rem; }
.tipo-desc { display:block; font-size:.73rem; font-weight:400; color:var(--g); margin-top:.3rem; line-height:1.3; }
.tipo-btn.sel .tipo-desc { color:var(--dk); opacity:.75; }
.modal-fornecedor { text-align:left; margin-bottom:1.2rem; }
.modal-fornecedor label { display:block; font-size:.82rem; font-weight:600; color:var(--g); margin-bottom:.3rem; }
.modal-fornecedor input { width:100%; box-sizing:border-box; padding:.55rem .75rem; border:1.5px solid var(--br); border-radius:7px; font-size:.92rem; background:#fff; color:var(--dk); }
.modal-fornecedor input:focus { outline:none; border-color:var(--dk); }
#btn-iniciar { width:100%; padding:.8rem; background:var(--dk); color:var(--y); border:none; border-radius:8px; font-size:1rem; font-weight:700; cursor:pointer; opacity:.4; transition:opacity .2s; }
#btn-iniciar:not(:disabled) { opacity:1; }
#btn-iniciar:not(:disabled):hover { background:#333; }
.tipo-badge { display:inline-block; padding:.15rem .55rem; border-radius:20px; font-size:.75rem; font-weight:700; margin-left:.4rem; }
.tipo-badge.prototipo { background:#e8f4fd; color:#1565c0; }
.tipo-badge.massivo { background:#e8f5e9; color:#2e7d32; }
/* ── Email approval section ── */
#email-aprovacao { margin:1.2rem 0; padding:1.2rem 1.5rem; border-radius:10px; border:2px solid; text-align:center; }
#email-aprovacao.aprovado { border-color:#4caf50; background:#f1f8e9; }
#email-aprovacao.reprovado { border-color:#f44336; background:#ffebee; }
#email-aprovacao h3 { margin:0 0 .5rem; font-size:1rem; }
#email-aprovacao p { margin:0 0 .9rem; font-size:.87rem; color:#555; }
#btn-email { padding:.65rem 1.4rem; border:none; border-radius:7px; font-size:.9rem; font-weight:700; cursor:pointer; color:#fff; }
#btn-email.aprovado { background:#388e3c; }
#btn-email.reprovado { background:#c62828; }

</style>
<div class="val-toast" id="valToast">
  <div class="val-toast-hdr">
    <span>⚠️</span>
    <span id="valToastMsg"></span>
    <button class="val-toast-close" onclick="document.getElementById('valToast').classList.remove('show')">×</button>
  </div>
  <div class="val-toast-list" id="valToastList"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>

<header>
  <div class="logo">
    <div class="logo-icon">ML</div>
    <div>
      <div class="logo-text" data-i18n="title">Checklist Flowrack 3x2m</div>
      <div class="logo-sub" data-i18n="subtitle">Evaluación de Equipamiento</div>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:10px">
    <div class="lang-toggle">
      <button id="btn-pt" onclick="switchLang('pt')">PT</button>
      <button id="btn-es" onclick="switchLang('es')" class="act">ES</button>
    </div>
    <div class="hdr-score">Nota: <span id="hdrVal">—</span></div>
  </div>
</header>


<div id="modal-tipo">
  <div class="modal-box">
    <h2 data-i18n="modalTipoTitle">Tipo de Avaliação</h2>
    <p data-i18n="modalTipoDesc">Selecione antes de iniciar a inspeção</p>
    <div class="tipo-btns">
      <button class="tipo-btn" id="btn-tipo-proto" onclick="setTipo('prototipo')">
        <span class="tipo-icon">🧪</span>
        <span data-i18n="tipoProto">Protótipo</span>
        <span class="tipo-desc" data-i18n="tipoProtoDesc">Novo equipamento de um novo fornecedor</span>
      </button>
      <button class="tipo-btn" id="btn-tipo-mass" onclick="setTipo('massivo')">
        <span class="tipo-icon">📦</span>
        <span data-i18n="tipoMass">Entrega Massiva</span>
        <span class="tipo-desc" data-i18n="tipoMassDesc">Entrega de lote de unidades com um fornecedor já homologado</span>
      </button>
    </div>
    <div class="modal-fornecedor">
      <label data-i18n="fornecedorLabel">Nome do Fornecedor <span style="font-weight:400;color:#888">(opcional)</span></label>
      <input type="text" id="fornecedor-input" data-i18n-ph="fornecedorPh" placeholder="Ex: Empresa XYZ Ltda">
    </div>
    <button id="btn-iniciar" disabled onclick="iniciarAvaliacao()" data-i18n="iniciarAval">Iniciar Avaliação</button>
  </div>
</div>


<main>

<div class="card card-top">
  <h2 data-i18n="infoTitle">Información de la Evaluación</h2>
  <div class="form-grid">
    <div class="field"><label data-i18n="evaluador">Evaluador</label><input type="text" id="evaluador" data-i18n-ph="evaluadorPh" placeholder="Tu nombre completo"></div>
    <div class="field"><label data-i18n="fecha">Fecha</label><input type="date" id="fecha"></div>
    <div class="field"><label data-i18n="sitio">Sitio / Almacén</label><input type="text" id="sitio" data-i18n-ph="sitioPh" placeholder="Ej: CD São Paulo"></div>
    <div class="field"><label data-i18n="pais">País</label>
      <select id="pais">
        <option value="">— Seleccionar —</option>
        <option value="MLB">MLB — Brasil</option>
        <option value="MLA">MLA — Argentina</option>
        <option value="MLM">MLM — México</option>
        <option value="MLC">MLC — Chile</option>
        <option value="MCO">MCO — Colombia</option>
        <option value="MLU">MLU — Uruguay</option>
      </select>
    </div>
  </div>
</div>

<div class="card">
  <div class="prog-wrap">
    <span data-i18n="itensEval">Ítems evaluados</span>
    <div class="prog-track"><div class="prog-fill" id="pFill"></div></div>
    <div class="prog-count" id="pCount">0 / 12</div>
  </div>
</div>

<!-- EQUIPO -->
<div class="section">
  <div class="sec-hdr" onclick="toggleSec('eq',this)">
    <h3><span data-i18n="secEq">Equipo — Funcional</span> <span class="sec-badge">6 <span data-i18n="items">ítems</span></span> <span class="sec-weight">· 60%</span></h3>
    <div style="display:flex;align-items:center;gap:7px">
      <div class="sec-score" id="sc-eq">—</div>
      <svg class="sec-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
    </div>
  </div>
  <div id="bd-eq"></div>
</div>

<!-- ESTRUCTURA -->
<div class="section">
  <div class="sec-hdr" onclick="toggleSec('es',this)">
    <h3><span data-i18n="secEs">Estructura</span> <span class="sec-badge">5 <span data-i18n="items2">ítems</span></span> <span class="sec-weight">· 40%</span></h3>
    <div style="display:flex;align-items:center;gap:7px">
      <div class="sec-score" id="sc-es">—</div>
      <svg class="sec-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
    </div>
  </div>
  <div id="bd-es"></div>
</div>

<!-- SCORE -->
<div class="score-panel">
  <h3 data-i18n="resultado">Resultado de la Evaluación</h3>
  <div class="srows">
    <div class="srow"><div class="srow-lbl" data-i18n="lblEq">Equipo — Funcional (60%)</div><div class="sbar-wrap"><div class="sbar" id="bar-eq"></div></div><div class="sval" id="val-eq">—</div></div>
    <div class="srow"><div class="srow-lbl" data-i18n="lblEs">Estructura (40%)</div><div class="sbar-wrap"><div class="sbar" id="bar-es"></div></div><div class="sval" id="val-es">—</div></div>
    <hr class="sdiv">
    <div class="stotal">
      <div class="stotal-lbl" data-i18n="evalFinal">Evaluación Final</div>
      <div class="stotal-val" id="val-tot">—</div>
      <div class="verdict" id="vdict"></div>
    </div>
  </div>
  <div class="scale-note" data-i18n="scaleNote">0%–40% Reprobado &nbsp;·&nbsp; 41%–80% Realizar ajustes &nbsp;·&nbsp; 81%–100% Aprobado</div>
</div>

<div class="actions">
  <button class="btn btn-dk" onclick="finalize()" data-i18n="finalizar">Finalizar evaluación</button>
