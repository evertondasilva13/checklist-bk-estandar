function imgWrap(src, i, labels) {
  var lbl = labels && labels[i] ? '<div class="ref-img-lbl">'+labels[i]+'</div>' : '';
  return '<div class="ref-img-wrap">'+lbl+'<img class="ref-img" src="'+src+'" alt="ref '+(i+1)+'" onclick="openLightbox(\''+src+'\')">'+'</div>';
}

function buildItem(item, sec, idx) {
  const key = sec+'_'+idx;
  const refImgs = REF_IMGS[key] || [];
  const refHtml = refImgs.length ? `
    <div class="ref-photos">
      <div class="ref-label">${T[LANG].refLabel}</div>
      <div class="ref-row">${refImgs.map((src,i) => imgWrap(src,i,item.labels)).join('')}</div>
    </div>` : '';
  const vchips = (item.v||[]).map(v => {
    if (v.u && !v.u.includes('PLACEHOLDER')) {
      return `<a class="vchip" href="${v.u}" target="_blank" rel="noopener"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>${v.n}</a>`;
    }
    return '';
  }).join('');
  const sugg = item.sugg ? `<div class="sugg">${item.sugg}</div>` : '';
  return `
  <div class="item">
    <div class="item-hdr" onclick="toggleItem(this)">
      <div class="item-num">${item.n}</div>
      <div class="item-main">
        <div class="item-title">${item.t}</div>
        <div class="item-sub">${item.s}</div>
      </div>
      <div class="rating-inline" onclick="event.stopPropagation()">
        <button class="rb malo"       onclick="rate('${sec}',${idx},'malo',this)">${S1}<span class="rb-lbl">${T[LANG].malo}</span></button>
        <button class="rb intermedio" onclick="rate('${sec}',${idx},'intermedio',this)">${S2}<span class="rb-lbl">${T[LANG].interm}</span></button>
        <button class="rb excelente"  onclick="rate('${sec}',${idx},'excelente',this)">${S3}<span class="rb-lbl">${T[LANG].excel}</span></button>
      </div>
      <div class="chev"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></div>
    </div>
    <div class="item-detail">
      ${refHtml}
      <div class="crit">${item.c}</div>
      <div class="tool"><div class="tool-lbl">${T[LANG].herramienta}</div>${item.h}</div>
      ${vchips ? `<div class="media-row">${vchips}</div>` : ''}
      ${sugg}
      <div class="cmnt"><label>${T[LANG].comentarios}</label><textarea placeholder="${T[LANG].obsPlaceholder}"></textarea></div>
      <div class="photos"><label>${T[LANG].fotos}</label>
        <div class="pdrop" onclick="this.querySelector('input').click()">
          <input type="file" accept="image/*,video/*" multiple onchange="previewF(this)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <div class="pdrop-txt">${T[LANG].addMedia}</div>
        </div>
        <div class="ppreview"></div>
      </div>
    </div>
  </div>`;
}

document.addEventListener('DOMContentLoaded', function() {
  Object.entries(ITEMS).forEach(([sec, items]) => {
    const bd = document.getElementById('bd-'+sec);
    if (bd) bd.innerHTML = items.map((it,i) => buildItem(it,sec,i)).join('');
  });
});

// ── Toggle section ──
function toggleSec(id, hdr) {
  const bd = document.getElementById('bd-'+id);
  const chev = hdr.querySelector('.sec-chev');
  const open = bd.style.display !== 'none';
  bd.style.display = open ? 'none' : 'block';
  chev.classList.toggle('open', !open);
}

// ── Toggle item ──
function toggleItem(hdr) {
  const det = hdr.nextElementSibling;
  const chev = hdr.querySelector('.chev');
  det.classList.toggle('open');
  chev.classList.toggle('open');
}

// ── Rate with toggle ──
function rate(sec, idx, val, btn) {
  if (btn.classList.contains('sel')) {
    R[sec][idx] = null;
    btn.classList.remove('sel');
    calcAll();
    return;
  }
  R[sec][idx] = val;
  btn.closest('.rating-inline').querySelectorAll('.rb').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
  calcAll();
  const currentHdr = btn.closest('.item-hdr');
  if (currentHdr) {
    const currentDet = currentHdr.nextElementSibling;
    if (currentDet && currentDet.classList.contains('open')) {
      currentDet.classList.remove('open');
      const chev = currentHdr.querySelector('.chev');
      if (chev) chev.classList.remove('open');
    }
    const nextItem = currentHdr.closest('.item').nextElementSibling;
    if (nextItem && nextItem.classList.contains('item')) {
      const nextHdr = nextItem.querySelector('.item-hdr');
      const nextDet = nextItem.querySelector('.item-detail');
      if (nextHdr && nextDet && !nextDet.classList.contains('open')) {
        nextDet.classList.add('open');
        const nextChev = nextHdr.querySelector('.chev');
        if (nextChev) nextChev.classList.add('open');
        setTimeout(() => nextHdr.scrollIntoView({behavior:'smooth', block:'nearest'}), 80);
      }
    }
  }
}

// ── Calc ──
function avg(sec) {
  const vals = R[sec].filter(v => v !== null);
  if (!vals.length) return null;
  return vals.reduce((a,v) => a + SM[v], 0) / vals.length;
}

function setBar(id, score) {
  const bar = document.getElementById('bar-'+id);
  const val = document.getElementById('val-'+id);
  const bdg = document.getElementById('sc-'+id);
  if (score === null) {
    bar.style.width = '0%'; val.textContent = '—'; val.style.color = '#999';
    if (bdg) bdg.textContent = '—'; return;
  }
  const p = Math.round(score * 100);
  const c = p<=40 ? 'var(--bad)' : p<=80 ? 'var(--mid)' : 'var(--ok)';
  bar.style.width = p+'%'; bar.style.background = c;
  val.textContent = p+'%'; val.style.color = c;
  if (bdg) bdg.textContent = p+'%';
}

function calcAll() {
  const eq = avg('eq'), es = avg('es');
  setBar('eq', eq); setBar('es', es);

  const done = ['eq','es'].reduce((a,s) => a + R[s].filter(v=>v!==null).length, 0);
  document.getElementById('pFill').style.width = (done/11*100)+'%';
  document.getElementById('pCount').textContent = done+' / 12';

  let fin = null;
  if (eq!==null && es!==null) fin = eq*.6 + es*.4;
  else if (eq!==null) fin = eq*.6;
  else if (es!==null) fin = es*.4;

  if (fin !== null) {
    const p = Math.round(fin*100);
    document.getElementById('val-tot').textContent = p+'%';
    document.getElementById('hdrVal').textContent = p+'%';
    const vd = T[LANG].verdicts;
    const [txt,cls] = p<=40 ? [vd.rep,'v-rep'] : p<=80 ? [vd.aj,'v-aj'] : [vd.ap,'v-ap'];
    const v = document.getElementById('vdict');
    v.textContent = txt; v.className = 'verdict '+cls;
  } else {
    document.getElementById('val-tot').textContent = '—';
    document.getElementById('hdrVal').textContent = '—';
    document.getElementById('vdict').textContent = '';
  }
}

// ── Photos ──
function previewF(input) {
  const prev = input.closest('.photos').querySelector('.ppreview');
  Array.from(input.files).forEach(f => {
    if (f.type.startsWith('image/')) {
      const r = new FileReader();
      r.onload = e => {
        const t = document.createElement('div'); t.className = 'pthumb';
        t.innerHTML = '<img src="'+e.target.result+'"><button class="prm" onclick="this.parentElement.remove()">×</button>';
        prev.appendChild(t);
      };
      r.readAsDataURL(f);
    } else {
      const sizeMB = (f.size / 1024 / 1024).toFixed(0);
      const t = document.createElement('div'); t.className = 'pthumb video-thumb';
      t.style.cssText = 'background:#1A1A1A;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px';
      t.innerHTML = '<span style="color:#FFE600;font-size:18px">▶</span><span style="color:#FFE600;font-size:7px;text-align:center;padding:0 3px;word-break:break-all">'+f.name.slice(0,12)+'</span><span style="color:#aaa;font-size:7px">'+sizeMB+'MB</span><button class="prm" onclick="this.parentElement.remove()">×</button>';
      t._videoFile = f;
      prev.appendChild(t);
    }
  });
}

// ── Validation toast ──
function showValidationToast(msg, items) {
  document.getElementById('valToastMsg').textContent = msg;
  document.getElementById('valToastList').innerHTML = items.map(i => '• ' + i).join('<br>');
  const t = document.getElementById('valToast');
  t.classList.remove('show');
  void t.offsetWidth;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 6000);
  const firstNum = items[0]?.match(/^(\d+)\./);
  if (firstNum) {
    const idx = parseInt(firstNum[1]) - 1;
    const el = document.querySelectorAll('.item')[idx];
    if (el) {
      el.querySelector('.item-detail')?.classList.add('open');
      el.scrollIntoView({ behavior:'smooth', block:'center' });
    }
  }
}

// ── Finalize + Save ──
async function finalize() {
  const t = T[LANG];
  const done = ['eq','es'].reduce((a,s) => a + R[s].filter(v=>v!==null).length, 0);
  if (done < 11) {
    showValidationToast(
      LANG==='pt' ? 'Avaliação incompleta' : 'Evaluación incompleta',
      [LANG==='pt' ? 'Faltam '+(12-done)+' item(ns) por avaliar.' : 'Faltan '+(12-done)+' ítem(s) por evaluar.']
    );
    return;
  }

  const evaluadorVal = document.getElementById('evaluador').value.trim();
  const sitioVal = document.getElementById('sitio').value.trim();
  const paisVal = document.getElementById('pais').value.trim();
  if (!evaluadorVal || !sitioVal || !paisVal) {
    const missing = [];
    if (!evaluadorVal) missing.push(LANG==='pt' ? 'Nome do avaliador é obrigatório.' : 'El nombre del evaluador es obligatorio.');
    if (!sitioVal) missing.push(LANG==='pt' ? 'Site / Operação é obrigatório.' : 'El sitio / operación es obligatorio.');
    if (!paisVal) missing.push(LANG==='pt' ? 'País é obrigatório.' : 'El país es obligatorio.');
    document.getElementById('evaluador').style.borderColor = evaluadorVal ? '' : 'var(--bad)';
    document.getElementById('sitio').style.borderColor = sitioVal ? '' : 'var(--bad)';
    document.getElementById('pais').style.borderColor = paisVal ? '' : 'var(--bad)';
    showValidationToast(LANG==='pt' ? 'Campos obrigatórios' : 'Campos obligatorios', missing);
    window.scrollTo({top:0, behavior:'smooth'});
    return;
  }
  document.getElementById('evaluador').style.borderColor = '';
  document.getElementById('sitio').style.borderColor = '';
  document.getElementById('pais').style.borderColor = '';

  const comentarios = {};
  document.querySelectorAll('.item').forEach((el, i) => {
    const ta = el.querySelector('textarea');
    if (ta && ta.value.trim()) comentarios[i] = ta.value.trim();
  });

  const allItems = document.querySelectorAll('.item');
  const secDefs = [{ key:'eq', offset:0 }, { key:'es', offset:6 }];
  const missing = [];
  secDefs.forEach(({ key, offset }) => {
    R[key].forEach((val, i) => {
      if (val === null) return;
      const el = allItems[offset + i];
      if (!el) return;
      const hasComment = !!(el.querySelector('textarea')?.value.trim().length > 0);
      const hasPhoto   = el.querySelectorAll('.ppreview img').length > 0 || el.querySelectorAll('.ppreview .video-thumb').length > 0;
      if (!hasComment && !hasPhoto) {
        const title = el.querySelector('.item-title')?.textContent || ('Item ' + (offset+i+1));
        missing.push((offset+i+1) + '. ' + title);
      }
    });
  });
  if (missing.length > 0) {
    showValidationToast(
      LANG==='pt' ? 'Todos os itens precisam de comentário ou foto:' : 'Todos los ítems requieren comentario o foto:',
      missing
    );
    return;
  }

  const eq = avg('eq'), es = avg('es');
  const fin = eq !== null && es !== null ? eq*.6 + es*.4 : eq !== null ? eq*.6 : es*.4;
  const p = Math.round(fin * 100);
  const vd = T[LANG].verdicts;
  const veredicto = p<=40 ? vd.rep : p<=80 ? vd.aj : vd.ap;
  const evaluador = document.getElementById('evaluador').value || null;
  const sitio = document.getElementById('sitio').value || null;

  const payload = {
    evaluador,
    fecha: document.getElementById('fecha').value || null,
    sitio,
    pais: document.getElementById('pais').value || null,
    idioma: LANG,
    score_eq: eq !== null ? Math.round(eq*100) : null,
    score_es: es !== null ? Math.round(es*100) : null,
    score_final: p,
    veredicto,
    ratings: { eq: R.eq, es: R.es },
    comentarios,
    fotos: [],
    equipo_tipo: 'Flowrack 3x2m',
    tipo_avaliacao: tipoAvaliacao,
    fornecedor: fornecedorNome || null
  };

  const btn = document.querySelector('[data-i18n="finalizar"]');
  const originalText = btn.textContent;
  btn.textContent = 'Enviando...';
  btn.disabled = true;

  try {
    const uploadQueue = [];
    secDefs.forEach(({ key, offset }) => {
      R[key].forEach((val, idx) => {
        if (val === null) return;
        const el = allItems[offset + idx];
        if (!el) return;
        const itemTitle  = el.querySelector('.item-title')?.textContent?.trim() || ('Item ' + (offset+idx+1));
        const itemNum    = offset + idx + 1;
        const itemRating = val;
        el.querySelectorAll('.ppreview img').forEach(img => {
          uploadQueue.push({ type:'image', src:img.src, itemTitle, itemNum, itemRating });
        });
        el.querySelectorAll('.ppreview .video-thumb').forEach(thumb => {
          if (thumb._videoFile) uploadQueue.push({ type:'video', file:thumb._videoFile, itemTitle, itemNum, itemRating });
        });
      });
    });

    const totalMedia = uploadQueue.length;
    if (totalMedia > 0 && _sb) {
      btn.textContent = (LANG==='pt' ? 'Enviando mídia (0/' : 'Subiendo archivos (0/') + totalMedia + ')...';
      let uploaded = 0;
      const safeSitio = (sitio || 'sem-sitio').replace(/[^a-zA-Z0-9_-]/g,'_');
      const uploadPromises = uploadQueue.map(async (item, i) => {
        try {
          let publicUrl = null;
          if (item.type === 'image') {
            const src = item.src;
            if (!src.startsWith('data:')) return;
            const arr = src.split(',');
            const mime = arr[0].match(/:(.*?);/)[1];
            const ext  = mime.split('/')[1] || 'jpg';
            const bstr = atob(arr[1]);
            const u8arr = new Uint8Array(bstr.length);
            for (let j = 0; j < bstr.length; j++) u8arr[j] = bstr.charCodeAt(j);
            const blob = new Blob([u8arr], { type: mime });
            const path = safeSitio + '/' + Date.now() + '_img' + i + '.' + ext;
            const { error: upErr } = await _sb.storage.from('avaliacoes-fotos').upload(path, blob, { contentType: mime, upsert: false });
            if (!upErr) ({ data: { publicUrl } } = _sb.storage.from('avaliacoes-fotos').getPublicUrl(path));
          } else {
            const f = item.file;
            if (f.size > 50 * 1024 * 1024) { console.warn('Video >50MB, skipped:', f.name); return; }
            const ext  = f.name.split('.').pop() || 'mp4';
            const path = safeSitio + '/' + Date.now() + '_vid' + i + '.' + ext;
            const { error: upErr } = await _sb.storage.from('avaliacoes-fotos').upload(path, f, { contentType: f.type, upsert: false });
            if (!upErr) ({ data: { publicUrl } } = _sb.storage.from('avaliacoes-fotos').getPublicUrl(path));
          }
          if (publicUrl) payload.fotos.push({ url: publicUrl, item: item.itemTitle, num: item.itemNum, rating: item.itemRating, type: item.type });
          uploaded++;
          btn.textContent = (LANG==='pt' ? 'Enviando mídia (' : 'Subiendo archivos (') + uploaded + '/' + totalMedia + ')...';
        } catch(e) { console.warn('Upload failed:', e); }
      });
      await Promise.all(uploadPromises);
    }

    if (!_sb) throw new Error('Supabase não disponível');
    btn.textContent = LANG==='pt' ? 'Salvando...' : 'Guardando...';
    const { error } = await _sb.from('evaluaciones').insert([payload]);
    if (error) throw error;

    btn.textContent = '✓ Enviado!';

    // ── E-mail de aprovação de protótipo ──
    if (tipoAvaliacao === 'prototipo') {
      const t = T[LANG];
      const aprovadoProto = p >= NOTA_CORTE_PROTOTIPO;
      const emailDiv = document.createElement('div');
      emailDiv.id = 'email-aprovacao';
      emailDiv.className = aprovadoProto ? 'aprovado' : 'reprovado';
      const titleKey = aprovadoProto ? 'emailAprovTitle' : 'emailReprovTitle';
      const descKey  = aprovadoProto ? 'emailAprovDesc'  : 'emailReprovDesc';
      const status   = aprovadoProto ? (LANG==='pt'?'APROVADO':'APROBADO') : (LANG==='pt'?'NÃO APROVADO':'NO APROBADO');
      const forn = fornecedorNome || (LANG==='pt'?'Não informado':'No informado');
      const dateVal = document.getElementById('fecha').value || new Date().toLocaleDateString();
      const sitioVal = document.getElementById('sitio').value || '—';
      const subject = encodeURIComponent(`[MercadoLibre BK] Protótipo Flowrack 3x2m — ${status} — ${forn}`);
      const body = encodeURIComponent(
        `Olá,

Segue o resultado da avaliação do protótipo:

` +
        `Equipamento: Flowrack 3x2m
` +
        `Fornecedor: ${forn}
` +
        `Site: ${sitioVal}
` +
        `Data: ${dateVal}
` +
        `Avaliador: ${evaluador}
` +
        `
Resultado: ${status}
` +
        `Nota Final: ${p}%
` +
        `  • Equipo — Funcional (60%): ${Math.round((eq||0)*100)}%
` +
        `  • Estrutura (40%): ${Math.round((es||0)*100)}%
` +
        `
${aprovadoProto
          ? 'O protótipo atendeu aos requisitos mínimos do MercadoLibre e está em condições de atender às demandas operacionais.'
          : 'O protótipo NÃO atendeu aos requisitos mínimos do MercadoLibre. São necessários ajustes antes da aprovação.'
        }

Este e-mail foi gerado automaticamente pelo sistema de inspeção BK Equipment.
`
      );
      emailDiv.innerHTML = `
        <h3>${t[titleKey]}</h3>
        <p>${t[descKey]}</p>
        <button id="btn-email" class="${aprovadoProto?'aprovado':'reprovado'}"
          onclick="window.location.href='mailto:?subject=${subject}&body=${body}'">
          📧 ${t.emailBtn}
        </button>`;
      document.querySelector('.actions').insertAdjacentElement('afterend', emailDiv);
    }
    btn.style.background = 'var(--ok)';
    setTimeout(() => {
      const params = new URLSearchParams({ lang: LANG, score: p, veredicto, evaluador: evaluador||'', sitio: sitio||'' });
      window.location.href = 'obrigado.html?' + params.toString();
    }, 900);

  } catch(err) {
    console.error(err);
    btn.textContent = LANG==='pt' ? 'Erro ao salvar' : 'Error al guardar';
    btn.style.background = 'var(--bad)';
    setTimeout(() => { btn.textContent = originalText; btn.style.background = ''; btn.disabled = false; }, 3000);
  }
}

document.getElementById('fecha').valueAsDate = new Date();
function openLightbox(src) { document.getElementById('lbImg').src = src; document.getElementById('lb').classList.add('open'); }
function closeLightbox() { document.getElementById('lb').classList.remove('open'); }
document.addEventListener('keydown', e => { if(e.key==='Escape') closeLightbox(); });
</script>
